# Browser API base. Leave empty to use the Vite /api proxy.
VITE_API_BASE=

# Server-only model configuration. Never expose secrets in VITE_* variables.
# Use local for the built-in rule engine, pollinations for the no-key free demo,
# gemini for the free-tier API, or openai-compatible for Groq/OpenRouter/Ollama.
LLM_PROVIDER=local

# Gemini free-tier option.
GEMINI_API_KEY=
GEMINI_MODEL=

# No-key free demo option through Pollinations. This sends the message to a
# third-party public endpoint, so it is opt-in and falls back to local rules.
# LLM_PROVIDER=pollinations
# LLM_MODEL=openai

# OpenAI-compatible option: Groq, OpenRouter, Ollama, LM Studio, and similar.
# Example local Ollama:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b-instruct
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional server storage and CORS overrides.
AOLINU_DB_PATH=server/data/aolinu.db
AOLINU_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

