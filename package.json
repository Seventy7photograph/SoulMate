{
  "name": "aolinu-soulmate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": ".venv\\Scripts\\python.exe -m uvicorn server.app:app --host 127.0.0.1 --port 8000 --reload",
